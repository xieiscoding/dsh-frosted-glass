{
  "name": "dsh-frosted-glass",
  "version": "2.0.0",
  "description": "Native Windows 11 acrylic frosted glass for the DeepSeek Harness desktop window: one continuous pane over the live desktop, floating glass for the composer and sent messages, with a reversible shell adaptation and a sampling fallback.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "electron",
    "windows",
    "acrylic",
    "mica",
    "glassmorphism",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "helper",
    "native",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
